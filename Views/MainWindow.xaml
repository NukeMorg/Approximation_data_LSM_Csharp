<Window x:Class="CurseWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Полиномиальная регрессия"
        Width="1200"
        Height="700"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        Loaded="MainWindow_OnLoaded">

    <DockPanel>

        <!-- ================= МЕНЮ ================= -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть данные" Click="MenuOpen_OnClick"/>
                <MenuItem Header="Загрузить модель" Click="MenuLoadModel_OnClick"/>
                <MenuItem Header="Сохранить результаты" Click="MenuSave_OnClick"/>
                <Separator/>
                <MenuItem Header="Выход" Click="MenuExit_OnClick"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Светлая тема"/>
                <MenuItem Header="Тёмная тема"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе"/>
            </MenuItem>
        </Menu>

        <!-- ================= СТАТУС ================= -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}"/>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="BusyProgress" Width="180" Height="14" IsIndeterminate="True" Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ================= ОСНОВНАЯ ОБЛАСТЬ ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- ЛЕВАЯ ПАНЕЛЬ -->
            <!-- ================================================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <!-- ===== Источник данных ===== -->
                    <GroupBox Header="Источник данных" Margin="0,0,0,10">
                        <StackPanel Margin="8">

                            <TextBlock Text="Путь к файлу / строка подключения"/>
                            <DockPanel Margin="0,2,0,6">
                                <TextBox x:Name="SourcePathTextBox" Width="200"/>
                                <Button Content="..." Width="26" Margin="4,0,0,0" Click="BrowseSource_OnClick"/>
                            </DockPanel>

                            <CheckBox x:Name="HasHeadersCheckBox" Content="Первая строка содержит заголовки" IsChecked="True"/>

                            <Separator Margin="6"/>

                            <TextBlock Text="Переменная X"/>
                            <ComboBox x:Name="XColumnCombo" Height="24" Margin="0,2,0,6"/>

                            <TextBlock Text="Переменная Y"/>
                            <ComboBox x:Name="YColumnCombo" Height="24" Margin="0,2,0,6"/>

                            <Button Content="Загрузить данные"
                                    Height="28"
                                    Margin="0,6,0,0"
                                    Click="LoadData_OnClick"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== Предпросмотр ===== -->
                    <GroupBox Header="Предпросмотр данных" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <DataGrid x:Name="PreviewGrid"
                                      Height="150"
                                      IsReadOnly="False"
                                      AutoGenerateColumns="True"
                                      CellEditEnding="PreviewGrid_OnCellEditEnding"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== Настройки модели ===== -->
                    <GroupBox Header="Параметры модели">
                        <StackPanel Margin="8">

                            <TextBlock Text="Степень полинома"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <Slider x:Name="DegreeSlider" Minimum="1" Maximum="10" Width="160" Value="3"/>
                                <TextBox x:Name="DegreeTextBox" Width="40" Margin="6,0,0,0" Text="3"/>
                            </StackPanel>

                            <CheckBox x:Name="AutoDegreeCheckBox" Content="Автоматический подбор степени"/>

                            <TextBlock Text="Метод аппроксимации" Margin="0,6,0,0"/>
                            <ComboBox x:Name="MethodCombo" Height="24" Margin="0,2,0,6" SelectedIndex="0" SelectionChanged="MethodCombo_SelectionChanged">
                                <ComboBoxItem Content="OLS"/>
                                <ComboBoxItem Content="WLS"/>
                                <ComboBoxItem Content="GLS"/>
                            </ComboBox>

                            <CheckBox x:Name="StandardizeCheckBox" Content="Стандартизация данных"/>
                            <CheckBox x:Name="ConfidenceCheckBox" Content="Расчёт доверительных интервалов"/>

                            <Button Content="Построить модель"
                                    Height="30"
                                    Margin="0,8,0,0"
                                    Click="BuildModel_OnClick"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ================================================= -->
            <!-- ЦЕНТР (график) -->
            <!-- ================================================= -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox x:Name="ShowGridCheckBox" Content="Показать сетку" Margin="10,0,0,0" Click="ShowGridCheckBox_Changed"/>
                    <Button Content="Экспорт графика" Margin="10,0,0,0" Click="ExportPlot_Click"/>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                    <oxy:PlotView x:Name="Plot2D" MouseDoubleClick="Plot2D_MouseDoubleClick"/>
                </Border>
            </Grid>

            <!-- ================================================= -->
            <!-- ПРАВАЯ ПАНЕЛЬ -->
            <!-- ================================================= -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <GroupBox Header="Уравнение регрессии" Margin="0,0,0,10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="100">
                            <TextBlock Margin="6"
                                       FontFamily="Consolas"
                                       Text="{Binding RegressionEquation}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </GroupBox>

                    <GroupBox Header="Коэффициенты" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding Coefficients}"
                                  AutoGenerateColumns="False"
                                  Height="160"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Индекс" Binding="{Binding Index}" Width="*"/>
                                <DataGridTextColumn Header="Значение" Binding="{Binding Value, StringFormat='G6'}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Предсказанные значения" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding Predictions}"
                                  AutoGenerateColumns="False"
                                  Height="160"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat='0.######'}" Width="*"/>
                                <DataGridTextColumn Header="Y (предск.)" Binding="{Binding PredictedY, StringFormat='0.######'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Показатели качества" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock Text="{Binding MSE, StringFormat='Среднеквадратичная ошибка (MSE): {0:F4}'}"/>
                            <TextBlock Text="{Binding RMSE, StringFormat='Корень MSE (RMSE): {0:F4}'}"/>
                            <TextBlock Text="{Binding R2, StringFormat='Коэффициент детерминации (R²): {0:F4}'}"/>
                            <TextBlock Text="{Binding AdjustedR2, StringFormat='Скорректированный R²: {0:F4}'}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Экспорт результатов">
                        <StackPanel Margin="6">
                            <Button Content="Сохранить отчёт" Click="SaveReport_Click"/>
                            <Button Content="Импорт модели" Margin="0,4,0,0" Click="ImportModel_Click"/>
                            <Button Content="Экспорт модели" Margin="0,4,0,0" Click="ExportModel_Click"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </DockPanel>
</Window>
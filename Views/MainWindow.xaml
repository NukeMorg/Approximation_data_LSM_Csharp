<Window x:Class="CurseWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:pt="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
        xmlns:conv="clr-namespace:CurseWork.Core.Converters"
        Title="Регрессионный анализ"
        Width="1200" Height="700" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть данные" Click="MenuOpen_OnClick"/>
                <Separator/>
                <MenuItem Header="Сохранить отчёт" Click="SaveReport_Click"/>
                <MenuItem Header="Экспорт графика" Click="ExportPlot_Click"/>
                <Separator/>
                <MenuItem Header="Закрыть" Click="MenuClose_OnClick"/>
                <MenuItem Header="Выход" Click="MenuExit_OnClick"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="Помощь" Click="HelpMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="О программе" Click="AboutMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Matlab">
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <ProgressBar x:Name="BusyProgress" Width="150" Height="14" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StatusBarItem>
            <!-- Кнопка выхода: прилипает к правому краю -->
            <StatusBarItem DockPanel.Dock="Right" Margin="5,0">
                <Button Content="Выход" Width="60" Height="22" Click="MenuExit_OnClick"/>
            </StatusBarItem>
        </StatusBar> 

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <GroupBox Header="Источник данных" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Путь к файлу"/>
                            <DockPanel Margin="0,2,0,6">
                                <TextBox x:Name="SourcePathTextBox" Width="200"/>
                                <Button Content="..." Width="26" Margin="4,0,0,0" Click="BrowseSource_OnClick"/>
                            </DockPanel>
                            <CheckBox x:Name="HasHeadersCheckBox" Content="Первая строка содержит заголовки" IsChecked="True"/>
                            <Separator Margin="0,6,0,6"/>
                            <TextBlock Text="X"/>
                            <ComboBox x:Name="XColumnCombo" Height="24" Margin="0,2,0,6"/>
                            <TextBlock Text="Y"/>
                            <ComboBox x:Name="YColumnCombo" Height="24" Margin="0,2,0,6"/>
                            <TextBlock x:Name="ZLabel" Text="Z (для 3D)" Visibility="Collapsed"/>
                            <ComboBox x:Name="ZColumnCombo" Height="24" Margin="0,2,0,6" Visibility="Collapsed"/>
                            <Button Content="Загрузить данные" Click="LoadData_OnClick" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Предпросмотр" Margin="0,0,0,10">
                        <DataGrid x:Name="PreviewGrid" Height="150" AutoGenerateColumns="True" CellEditEnding="PreviewGrid_OnCellEditEnding"/>
                    </GroupBox>

                    <!-- 2D панель -->
                    <StackPanel x:Name="Panel2DSettings">
                        <GroupBox Header="2D параметры">
                            <StackPanel>
                                <TextBlock Text="Степень полинома"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="DegreeSlider" Minimum="1" Maximum="10" Width="150" Value="3"/>
                                    <TextBox x:Name="DegreeTextBox" Width="40" Margin="6,0,0,0" Text="3"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoDegreeCheckBox" Content="Автоматический подбор степени" Margin="0,4,0,0"/>
                                <TextBlock Text="Метод аппроксимации" Margin="0,8,0,0"/>
                                <ComboBox x:Name="MethodCombo" Height="24" Margin="0,2,0,6" SelectedIndex="0" SelectionChanged="MethodCombo_SelectionChanged">
                                    <ComboBoxItem Content="OLS"/>
                                    <ComboBoxItem Content="WLS"/>
                                    <ComboBoxItem Content="GLS"/>
                                </ComboBox>

                                <!-- Цвет линии модели (2D) -->
                                <TextBlock Text="Цвет линии модели" Margin="0,8,0,0"/>
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="ColorPreviewLine2D" Grid.Column="0"
                                               Width="24" Height="24" Margin="0,0,6,0"
                                               Stroke="Gray" StrokeThickness="1"
                                               RadiusX="3" RadiusY="3"
                                               Fill="{Binding LineColor, Converter={StaticResource ColorToBrushConverter}}"/>
                                    <pt:ColorPicker x:Name="LineColorPicker" Grid.Column="1" Height="24"
                                                    SelectedColor="{Binding LineColor, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        <Button Content="Построить 2D модель" Click="Build2DModel_OnClick" Height="30" Margin="0,15,0,0"/>
                    </StackPanel>

                    <!-- 3D панель -->
                    <StackPanel x:Name="Panel3DSettings" Visibility="Collapsed"
                                DataContext="{Binding ThreeD}">
                        <GroupBox Header="3D параметры">
                            <StackPanel>
                                <TextBlock Text="Тип поверхности"/>
                                <ComboBox x:Name="SurfaceTypeCombo" Height="24" Margin="0,2,0,6"
                                          SelectedItem="{Binding SurfaceType}">
                                    <ComboBoxItem Content="Плоскость"/>
                                    <ComboBoxItem Content="Квадрика (полная)"/>
                                </ComboBox>

                                <TextBlock Text="Цвет поверхности" Margin="0,6,0,0"/>
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="ColorPreviewRect" Grid.Column="0"
                                               Width="24" Height="24" Margin="0,0,6,0"
                                               Stroke="Gray" StrokeThickness="1"
                                               RadiusX="3" RadiusY="3"
                                               Fill="{Binding SurfaceColor, Converter={StaticResource ColorToBrushConverter}}"/>
                                    <pt:ColorPicker x:Name="SurfaceColorPicker" Grid.Column="1" Height="24"
                                                    SelectedColor="{Binding SurfaceColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                </Grid>

                                <Button Content="Построить 3D модель" Command="{Binding BuildModelCommand}"
                                        Height="30" Margin="0,15,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Центральная область -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Тулбар: кнопки режимов и чекбокс сетки (только 2D) -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                    <ToggleButton x:Name="Toggle2D" Content="2D режим" Width="80" IsChecked="True" 
                        Checked="ToggleMode_Checked" Unchecked="ToggleMode_Checked" Margin="0,0,5,0"/>
                    <ToggleButton x:Name="Toggle3D" Content="3D режим" Width="80" Margin="0,0,5,0" 
                        Checked="ToggleMode_Checked" Unchecked="ToggleMode_Checked"/>
                    <CheckBox x:Name="ShowGridCheckBox" Content="Показать сетку (2D)" Margin="15,0,0,0" 
                              Click="ShowGridCheckBox_Changed" Visibility="Visible"/>
                </StackPanel>

                <Border x:Name="Plot2DBorder" Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                    <oxy:PlotView x:Name="Plot2D"/>
                </Border>
                <Border x:Name="Plot3DBorder" Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Visibility="Collapsed">
                    <h:HelixViewport3D x:Name="Viewport3D">
                        <h:DefaultLights/>
                    </h:HelixViewport3D>
                </Border>
            </Grid>

            <!-- Правая панель результатов -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <GroupBox Header="Уравнение регрессии" Margin="0,0,0,10">
                        <TextBlock Text="{Binding RegressionEquation}" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </GroupBox>
                    <GroupBox Header="Коэффициенты" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding Coefficients}" AutoGenerateColumns="False" Height="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Индекс" Binding="{Binding Index}" Width="*"/>
                                <DataGridTextColumn Header="Значение" Binding="{Binding Value, StringFormat='G6'}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Header="Предсказанные значения" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding Predictions}" AutoGenerateColumns="False" Height="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat='0.######'}" Width="*"/>
                                <DataGridTextColumn Header="Y/Z (предск.)" Binding="{Binding PredictedY, StringFormat='0.######'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Header="Показатели качества" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding MSE, StringFormat='Среднеквадратичная ошибка (MSE): {0:F4}'}"/>
                            <TextBlock Text="{Binding RMSE, StringFormat='Корень MSE (RMSE): {0:F4}'}"/>
                            <TextBlock Text="{Binding R2, StringFormat='Коэффициент детерминации (R²): {0:F4}'}"/>
                            <TextBlock Text="{Binding AdjustedR2, StringFormat='Скорректированный R²: {0:F4}'}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Экспорт результатов">
                        <StackPanel>
                            <Button Content="Сохранить отчёт" Click="SaveReport_Click"/>
                            <Button Content="Экспорт графика" Click="ExportPlot_Click" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
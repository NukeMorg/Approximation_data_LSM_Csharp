<Window x:Class="CurseWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Полиномиальная регрессия"
        Width="1200"
        Height="700"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        FontSize="13">

    <DockPanel>

        <!-- ================= МЕНЮ ================= -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть данные"/>
                <MenuItem Header="Сохранить результаты"/>
                <Separator/>
                <MenuItem Header="Выход"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Светлая тема"/>
                <MenuItem Header="Тёмная тема"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе"/>
            </MenuItem>
        </Menu>

        <!-- ================= СТАТУС ================= -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Готово"/>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="180" Height="14"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ================= ОСНОВНАЯ ОБЛАСТЬ ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- ЛЕВАЯ ПАНЕЛЬ -->
            <!-- ================================================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <!-- ===== Источник данных ===== -->
                    <GroupBox Header="Источник данных" Margin="0,0,0,10">
                        <StackPanel Margin="8">

                            <TextBlock Text="Тип источника данных"/>
                            <ComboBox Height="24" Margin="0,2,0,6">
                                <ComboBoxItem Content="CSV / TXT файл"/>
                                <ComboBoxItem Content="Excel файл"/>
                                <ComboBoxItem Content="База данных (SQLite)"/>
                            </ComboBox>

                            <TextBlock Text="Путь к файлу / строка подключения"/>
                            <DockPanel Margin="0,2,0,6">
                                <TextBox Width="200"/>
                                <Button Content="..." Width="26" Margin="4,0,0,0"/>
                            </DockPanel>

                            <CheckBox Content="Первая строка содержит заголовки"/>

                            <Separator Margin="6"/>

                            <TextBlock Text="Независимая переменная (X)"/>
                            <ComboBox Height="24" Margin="0,2,0,6"/>

                            <TextBlock Text="Зависимая переменная (Y)"/>
                            <ComboBox Height="24" Margin="0,2,0,6"/>

                            <TextBlock Text="Дополнительная переменная (Z, при наличии)"/>
                            <ComboBox Height="24" Margin="0,2,0,6"/>

                            <Button Content="Загрузить данные"
                                    Height="28"
                                    Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== Предпросмотр ===== -->
                    <GroupBox Header="Предпросмотр данных" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <DataGrid Height="150"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="True"/>
                            <Button Content="Показать все данные"
                                    Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== Настройки модели ===== -->
                    <GroupBox Header="Параметры модели">
                        <StackPanel Margin="8">

                            <TextBlock Text="Степень полинома"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <Slider Minimum="1" Maximum="15" Width="160"/>
                                <TextBox Width="40" Margin="6,0,0,0"/>
                            </StackPanel>

                            <CheckBox Content="Автоматический подбор степени"/>

                            <TextBlock Text="Метод аппроксимации" Margin="0,6,0,0"/>
                            <ComboBox Height="24" Margin="0,2,0,6">
                                <ComboBoxItem Content="Метод наименьших квадратов"/>
                                <ComboBoxItem Content="Взвешенный МНК"/>
                            </ComboBox>

                            <CheckBox Content="Стандартизация данных"/>
                            <CheckBox Content="Расчёт доверительных интервалов"/>

                            <Button Content="Построить модель"
                                    Height="30"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ================================================= -->
            <!-- ЦЕНТР -->
            <!-- ================================================= -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ToggleButton Content="2D" Width="40" IsChecked="True"/>
                    <ToggleButton Content="3D" Width="40" Margin="4,0,0,0"/>
                    <CheckBox Content="Показать сетку" Margin="10,0,0,0"/>
                    <Button Content="Экспорт графика" Margin="10,0,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                    <Grid x:Name="PlotHost"/>
                </Border>

                <TabControl Grid.Row="2" Margin="0,6,0,0">
                    <TabItem Header="Таблица данных">
                        <DataGrid AutoGenerateColumns="True"/>
                    </TabItem>
                    <TabItem Header="Остатки"/>
                    <TabItem Header="Q-Q график"/>
                </TabControl>
            </Grid>

            <!-- ================================================= -->
            <!-- ПРАВАЯ ПАНЕЛЬ -->
            <!-- ================================================= -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <GroupBox Header="Уравнение регрессии" Margin="0,0,0,10">
                        <TextBlock Margin="6"
                                   FontFamily="Consolas"
                                   Text="{Binding RegressionEquation}"/>
                    </GroupBox>

                    <GroupBox Header="Коэффициенты" Margin="0,0,0,10">
                        <DataGrid Height="160"
                                  AutoGenerateColumns="True"/>
                    </GroupBox>

                    <GroupBox Header="Показатели качества" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock Text="{Binding MSE, StringFormat='Среднеквадратичная ошибка (MSE): {0:F4}'}"/>
                            <TextBlock Text="{Binding RMSE, StringFormat='Корень MSE (RMSE): {0:F4}'}"/>
                            <TextBlock Text="{Binding R2, StringFormat='Коэффициент детерминации (R²): {0:F4}'}"/>
                            <TextBlock Text="{Binding AdjustedR2, StringFormat='Скорректированный R²: {0:F4}'}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Экспорт результатов">
                        <StackPanel Margin="6">
                            <Button Content="Сохранить отчёт"/>
                            <Button Content="Экспорт коэффициентов" Margin="0,4,0,0"/>
                            <Button Content="Экспорт предсказаний" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </DockPanel>
</Window>

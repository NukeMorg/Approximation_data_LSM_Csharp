<Window x:Class="CurseWork.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Width="400" Height="250"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Margin="20">
        <TextBlock Text="Регрессионный анализ" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Text="Версия 1.0.0" Margin="0,0,0,5"/>
        <TextBlock Text="Программа для полиномиальной и 3D регрессии." Margin="0,0,0,10"/>
        <TextBlock Text="Разработчик: Ваше имя / команда" Margin="0,0,0,10"/>
        <TextBlock Text="© 2025 Все права защищены" Foreground="Gray"/>
        <Button Content="Закрыть" Width="80" Margin="0,15,0,0" Click="CloseButton_Click"/>
    </StackPanel>
</Window>